{
  "rules": {
    "upbox": {
      "messages": {
        ".read": "auth != null || root.child('upbox/guestSession/active').val() === true",
        ".write": "auth != null || root.child('upbox/guestSession/active').val() === true"
      },
      "guestSession": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
